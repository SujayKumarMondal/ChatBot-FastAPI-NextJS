# ============================================================
# ChatPaat - Render Production Environment Configuration
# ============================================================
# This file documents all required environment variables for Render deployment
# Copy values to Render's environment variables dashboard
# DO NOT commit actual .env file to version control!
# ============================================================

# ============================================================
# Environment
# ============================================================
ENVIRONMENT=production
DEBUG=false

# ============================================================
# Database Configuration (Supabase PostgreSQL)
# ============================================================
USE_POSTGRES=true
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_password
DB_HOST=db.xxxxx.supabase.co
DB_PORT=5432
DB_SCHEMA=public

# ============================================================
# FastAPI / CORS Configuration
# ============================================================
ALLOWED_ORIGINS=https://your-frontend.render.com,https://your-domain.com
HOST=0.0.0.0
PORT=10000

# ============================================================
# Authentication & Security
# ============================================================
SECRET_KEY=your_super_secret_key_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# Google OAuth Configuration
# ============================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
FRONTEND_URL=https://your-frontend.render.com

# ============================================================
# Groq API Configuration (for AI features)
# ============================================================
GROQ_API_KEY=your_groq_api_key
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# ============================================================
# Email Configuration (SendGrid)
# ============================================================
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@your-domain.com

# ============================================================
# Alembic Database Migrations
# ============================================================
# Alembic automatically uses DATABASE_URL constructed from above vars
# No additional configuration needed
